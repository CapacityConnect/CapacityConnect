rules_version = '2';

// Deploy: Firebase Console -> Storage -> Rules -> paste -> Publish
// (or `firebase deploy --only storage`).
// These rules use cross-service Firestore lookups; the first deploy will ask
// you to grant Storage permission to read Firestore — accept it.

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && userDoc().role == "admin" && userDoc().status == "approved";
    }

    function isApprovedTrainer() {
      return isSignedIn() && userDoc().role == "trainer" && userDoc().status == "approved";
    }

    function ownsCourse(courseId) {
      return isApprovedTrainer()
        && firestore.get(/databases/(default)/documents/courses/$(courseId)).data.trainerId == request.auth.uid;
    }

    // 50 MB cap and an allow-list of learning-material types.
    function validUpload() {
      return request.resource.size < 50 * 1024 * 1024
        && (
          request.resource.contentType.matches('application/pdf')
          || request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('video/.*')
          || request.resource.contentType.matches('audio/.*')
          || request.resource.contentType.matches('text/plain')
          || request.resource.contentType.matches('text/csv')
          || request.resource.contentType.matches('application/zip')
          || request.resource.contentType.matches('application/vnd\\.openxmlformats-officedocument\\..*')
          || request.resource.contentType.matches('application/vnd\\.ms-.*')
          || request.resource.contentType.matches('application/msword')
        );
    }

    // Course materials: only the course's own approved trainer (or an admin)
    // can upload/replace/delete. Enrolled learners and staff can download.
    match /courses/{courseId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if (ownsCourse(courseId) || isAdmin()) && validUpload();
      allow delete: if ownsCourse(courseId) || isAdmin();
    }

    // Trainer library: each trainer writes only under their own uid folder.
    match /library/{ownerId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if ((isApprovedTrainer() && ownerId == request.auth.uid) || isAdmin()) && validUpload();
      allow delete: if (isApprovedTrainer() && ownerId == request.auth.uid) || isAdmin();
    }

    // Legacy flat library uploads (before per-trainer folders): read-only.
    match /library/{fileName} {
      allow read: if isSignedIn();
      allow delete: if isAdmin();
      allow create, update: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
